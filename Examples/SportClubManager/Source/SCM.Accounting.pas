/// <summary>Accounting engine of the application: builds the double-entry journal
/// entries generated by enrollment approval and payment collection, numbers
/// movements and VAT protocols, and performs the year-end closing and reopening
/// of the balance sheet.</summary>
unit SCM.Accounting;

interface

uses
  DB
  , KItto.Store
  , Kitto.Metadata.Models
  , Kitto.Metadata.DataView
  , EF.Tree
  , EF.DB;

const
  //ENTRY TYPE
  SIMPLE_ENTRY = 'AS';
  COMPLEX_ENTRY = 'AC';
  CUSTOMER_INVOICE = 'FC';
  SUPPLIER_INVOICE = 'FF';
  CUSTOMER_CREDIT_NOTE = 'NC';
  SUPPLIER_CREDIT_NOTE = 'NF';
  OPENING_ENTRIES = 'MA';
  CLOSING_ENTRIES = 'MC';

  //SIGN
  DEBIT_SIGN = 'D';
  CREDIT_SIGN = 'A';

  //REASON TYPE
  GENERAL_LEDGER = 'GEN';
  SALES_VAT = 'CLI';
  PURCHASES_VAT = 'FOR';
  COLLECTION = 'INC';
  PAYMENT = 'PAG';

  //LEGAL FORM
  SOLE_PROPRIETORSHIP = 'DI';
  PRIVATE_INDIVIDUAL = 'PRI';
  GENERAL_PARTNERSHIP = 'SNC';
  JOINT_STOCK_COMPANY = 'SPA';
  LIMITED_LIABILITY_COMPANY = 'SRL';

  //automatic reasons
  PAYMENT_COLLECTION = 'INCPAG';
  SUBSCRIPTION = 'ISCR';
  BALANCE_SHEET_OPENING = 'APEBIL';
  BALANCE_SHEET_CLOSING = 'CHIUBIL';
  YEAR_PROFIT = 'UTILESERC';
  YEAR_LOSS = 'PERDESERC';
  PREV_YEAR_PROFIT = 'UTILESERCPREC';
  PREV_YEAR_LOSS = 'PERDESERCPREC';

  //FINANCIAL YEAR
  YEAR_CLOSED = 'C';
  YEAR_OPEN = 'A';

function NewEntryNumber(AFinancialYearId :  string) : integer;
procedure UpdateVatProtocol(AEntryId: string; AVatRegisterId : string; ADate : TDateTime);

function IsVatEntry(AEntryType : string): boolean;
function IsCustomerVatEntry(AEntryType : string): boolean;
function IsSupplierVatEntry(AEntryType : string): boolean;

//customer insertion
function InsertOrUpdateCustomer(const APersonId : string): string;

//insert the collection entry for the subscription instalment
procedure InsertCollectionEntryFromPayments(const ARecord: TKRecord);

//insert the subscription entry
procedure InsertSubscriptionEntry(const ARecord: TKRecord);

//returns the automatic reason
function GetReason(const AAutomaticReasonId : string) : string;

//returns the automatic reason description
function GetReasonDescription(const AAutomaticReasonId : string) : string;

//returns the posting type of the reason
function GetReasonPostingType(const AReasonId : string) : string;

//Returns the financial year open at the given date
function GetFinancialYearFromDate(const ADate : TDateTime): string;

//returns the query for the automatic accounts
function GetSQLAutomaticAccounts: string;

// returns the query that reads the reason data
function GetSQLReasonData: string;

//returns the insert query for the entries
function GetSQLInsertEntry: string;

//returns the insert query for the entry lines
function GetSQLInsertLine: string;

//returns the insert query for the VAT detail
function GetSQLInsertVatDetail: string;

//returns the insert query for the withholding taxes
function GetSQLInsertWithholdingDetail: string;

// returns the query that reads the subscription data
function GetSQLSubscriptionData: string;

//returns the query for the counterpart balance
function GetSQLCounterpartBalance: string;

//Closing and opening entries of the balance sheet
procedure CloseAndReopenBalanceSheet(const ServerStore: TKViewTableStore);

//Insert the accounting entry that closes the financial year
procedure InsertClosingEntry(const ACommandInsertEntry, ACommandInsertLine: TEFDBCommand;
  AClosingYearId, AClosingAutoReasonId, AClosingAutoReasonDesc : string; AFinancialYearEnd : TDateTime;
  AClosingReasonDataQuery, AClosingAutoAccountsQuery, ACounterpartBalanceQuery: TEFDBQuery;
  AAccountId, ADescription, ASign, ASection : string; ABalance : Currency);

//insert the accounting entry that opens the financial year
procedure InsertOpeningEntry(const ACommandInsertEntry, ACommandInsertLine: TEFDBCommand;
  AOpeningYearId, AOpeningAutoReasonId, AOpeningAutoReasonDesc : string; AFinancialYearStart : TDateTime;
  AOpeningReasonDataQuery, AOpeningAutoAccountsQuery, ACounterpartBalanceQuery: TEFDBQuery;
  AAccountId, ADescription, ASign : string; ABalance : Currency);

//insert the entry for the profit or loss of the year
procedure InsertProfitOrLossEntry(const ACommandInsertEntry, ACommandInsertLine: TEFDBCommand;
  AFinancialYearId, AAutoReasonId, AAutoReasonDesc : string; ADate : TDateTime;
  AReasonDataQuery, AAutoAccountsQuery: TEFDBQuery;
  LProfitOrLoss : Currency; ANewFinancialYear : boolean);

//Closes the financial year
procedure CloseFinancialYear(AFinancialYearId : string);


implementation

uses
  SCM.Utils
  ,RegularExpressions
  ,EF.Localization
  ,Kitto.Config
  ,Kitto.Auth.DB
  ,Kitto.Rules
  ,System.SysUtils
  ,EF.StrUtils
  ,System.Variants
  ,EF.VariantUtils
  ,DateUtils
  ,SCM.DbUtils, Kitto.DbUtils;

function NewEntryNumber(AFinancialYearId :  string) : integer;
begin
  //read the entry number
  Result := EFVarToInt(TKConfig.Database.GetSingletonValue('SELECT NRMOV FROM ESERCIZICONTABILI WHERE ID = ''' + AFinancialYearId + ''''))+1;
  //write the new entry number to the database
  TKConfig.Database.ExecuteImmediate('UPDATE ESERCIZICONTABILI SET NRMOV = '+IntToStr(Result)+' WHERE ID = ''' + AFinancialYearId + '''' );
end;

procedure UpdateVatProtocol(AEntryId: string; AVatRegisterId : string; ADate : TDateTime);
var
  LProtIVA : integer;
  LCurrentVatYear : boolean;
begin
  LCurrentVatYear := YearOf(date) = YearOf(ADate);

  if LCurrentVatYear then
  begin
    //read the VAT protocol number
    LProtIVA := EFVarToInt(TKConfig.Database.GetSingletonValue('SELECT NR_PROT FROM REGISTRI_IVA WHERE ID = ''' + AVatRegisterId + ''''))+1;
    //write the new VAT protocol number to the database
    TKConfig.Database.ExecuteImmediate('UPDATE REGISTRI_IVA SET NR_PROT = '+IntToStr(LProtIVA)+', DATA_ULT_PROT = ''' + DateToCompactStr(ADate) + ''' WHERE ID = ''' + AVatRegisterId + '''' );

  end
  else
  begin
    //read the VAT protocol number
    LProtIVA := EFVarToInt(TKConfig.Database.GetSingletonValue('SELECT NR_PROT_PREC FROM REGISTRI_IVA WHERE ID = ''' + AVatRegisterId + ''''))+1;
    //write the new VAT protocol number to the database
    TKConfig.Database.ExecuteImmediate('UPDATE REGISTRI_IVA SET NR_PROT_PREC = '+IntToStr(LProtIVA)+', DATA_ULT_PROT_PREC = ''' + DateToCompactStr(ADate) + ''' WHERE ID = ''' + AVatRegisterId + '''' );
  end;

  TKConfig.Database.ExecuteImmediate('UPDATE MOVIMENTI_CONTABILI SET NR_IVA = '+IntToStr(LProtIVA)+' WHERE ID = ''' + AEntryId + '''' );
end;

function IsVatEntry(AEntryType : string): boolean;
begin
  Result := (AEntryType = CUSTOMER_INVOICE) or
            (AEntryType = SUPPLIER_INVOICE ) or
            (AEntryType = CUSTOMER_CREDIT_NOTE ) or
            (AEntryType = SUPPLIER_CREDIT_NOTE);
end;

function IsCustomerVatEntry(AEntryType : string): boolean;
begin
  Result := (AEntryType = CUSTOMER_INVOICE) or
            (AEntryType = SUPPLIER_INVOICE );
end;

function IsSupplierVatEntry(AEntryType : string): boolean;
begin
  Result := (AEntryType = CUSTOMER_CREDIT_NOTE ) or
            (AEntryType = SUPPLIER_CREDIT_NOTE);
end;

function InsertOrUpdateCustomer(const APersonId : string): string;
var
  LQuery: TEFDBQuery;
  LQueryText: string;
  LCommandText: string;
  LCommand: TEFDBCommand;
  LCustomerId : string;
begin
  LQuery := TKConfig.Database.CreateDBQuery;
  LCommand := TKConfig.Database.CreateDBCommand;
  Try
    //Read the data from the registry

    LQueryText := 'SELECT CODFISC, COGNOME, NOME, TELEFONO, CELLULARE, EMAIL, INDIRIZZO, CAP, '+
                    'PROVINCIAID, COMUNEID, DATANASC, LUOGONASCID, PROVNASCID, SESSO, NAZIONALITAID, IBAN '+
                    'FROM NOMINATIVI WHERE ID = :ID';
    LQuery.CommandText := LQueryText;
    LQuery.Params.ParamByName('ID').AsString := APersonId;
    LQuery.Open;
    try
      if not LQuery.DataSet.IsEmpty then
      begin
        LCustomerId := EFVarToStr(TKConfig.Database.GetSingletonValue('SELECT ID FROM CLIENTI WHERE CODFISCALE = '+QuotedStr(LQuery.DataSet.FieldByName('CODFISC').AsString)));

        if LCustomerId <> '' then
        begin
          LCommandText :=  'UPDATE CLIENTI '+
                           'SET DX = :DX '+
                           '   ,COGNOME = :COGNOME '+
                           '   ,NOME = :NOME '+
                           '   ,CODFISCALE = :CODFISCALE '+
                           '   ,INDIRIZZO = :INDIRIZZO '+
                           '   ,CAP = :CAP '+
                           '   ,PROVINCIAID = :PROVINCIAID '+
                           '   ,IBAN = :IBAN '+
                           '   ,EMAIL = :EMAIL '+
                           '   ,INDIRIZZO_AMM = :INDIRIZZO_AMM '+
                           '   ,CAP_AMM = :CAP_AMM '+
                           '   ,COMUNE_AMMID = :COMUNE_AMMID '+
                           '   ,PROVINCIA_AMMID = :PROVINCIA_AMMID '+
                           '   ,COMUNEID = :COMUNEID '+
                           '   ,FORMA_GIURIID = :FORMA_GIURIID '+
                           '   ,FLAG_INDI_AMM = :FLAG_INDI_AMM '+
                           '   ,TELEFONO = :TELEFONO '+
                           '   ,CELLULARE = :CELLULARE '+
                           'WHERE ID = :ID ';
        end
        else
        begin
          LCustomerId := CalcNewProgress('TISCliente', 10);
          LCommandText := 'INSERT INTO CLIENTI '+
                          '   (ID '+
                          '   ,DX '+
                          '   ,COGNOME '+
                          '   ,NOME '+
                          '   ,CODFISCALE '+
                          '   ,INDIRIZZO '+
                          '   ,CAP '+
                          '   ,PROVINCIAID '+
                          '   ,IBAN '+
                          '   ,EMAIL '+
                          '   ,INDIRIZZO_AMM '+
                          '   ,CAP_AMM '+
                          '   ,COMUNE_AMMID '+
                          '   ,PROVINCIA_AMMID '+
                          '   ,COMUNEID '+
                          '   ,FORMA_GIURIID '+
                          '   ,FLAG_INDI_AMM '+
                          '   ,TELEFONO '+
                          '   ,CELLULARE) '+
                          'VALUES '+
                          '  (:ID '+
                          '   ,:DX '+
                          '   ,:COGNOME '+
                          '   ,:NOME '+
                          '   ,:CODFISCALE '+
                          '   ,:INDIRIZZO '+
                          '   ,:CAP '+
                          '   ,:PROVINCIAID '+
                          '   ,:IBAN '+
                          '   ,:EMAIL '+
                          '   ,:INDIRIZZO_AMM '+
                          '   ,:CAP_AMM '+
                          '   ,:COMUNE_AMMID '+
                          '   ,:PROVINCIA_AMMID '+
                          '   ,:COMUNEID '+
                          '   ,:FORMA_GIURIID '+
                          '   ,:FLAG_INDI_AMM '+
                          '   ,:TELEFONO '+
                          '   ,:CELLULARE) ';
        end;
        LCommand.CommandText := LCommandText;

        UpdateParamValue(LCommand.Params,'ID', LCustomerId);
        UpdateParamValue(LCommand.Params,'DX', LQuery.DataSet.FieldByName('COGNOME').AsString+' '+LQuery.DataSet.FieldByName('NOME').AsString);
        UpdateParamValue(LCommand.Params,'COGNOME', LQuery.DataSet.FieldByName('COGNOME').AsString);
        UpdateParamValue(LCommand.Params,'NOME', LQuery.DataSet.FieldByName('NOME').AsString);
        UpdateParamValue(LCommand.Params,'CODFISCALE', LQuery.DataSet.FieldByName('CODFISC').AsString);
        UpdateParamValue(LCommand.Params,'INDIRIZZO', LQuery.DataSet.FieldByName('INDIRIZZO').AsString);
        UpdateParamValue(LCommand.Params,'CAP', LQuery.DataSet.FieldByName('CAP').AsString);
        UpdateParamValue(LCommand.Params,'PROVINCIAID', LQuery.DataSet.FieldByName('PROVINCIAID').AsString);
        UpdateParamValue(LCommand.Params,'IBAN', LQuery.DataSet.FieldByName('IBAN').AsString);
        UpdateParamValue(LCommand.Params,'EMAIL', LQuery.DataSet.FieldByName('EMAIL').AsString);
        UpdateParamValue(LCommand.Params,'INDIRIZZO_AMM', LQuery.DataSet.FieldByName('INDIRIZZO').AsString);
        UpdateParamValue(LCommand.Params,'CAP_AMM', LQuery.DataSet.FieldByName('CAP').AsString);
        UpdateParamValue(LCommand.Params,'COMUNE_AMMID', LQuery.DataSet.FieldByName('COMUNEID').AsString);
        UpdateParamValue(LCommand.Params,'PROVINCIA_AMMID', LQuery.DataSet.FieldByName('PROVINCIAID').AsString);
        UpdateParamValue(LCommand.Params,'COMUNEID', LQuery.DataSet.FieldByName('COMUNEID').AsString);
        UpdateParamValue(LCommand.Params,'FORMA_GIURIID', PRIVATE_INDIVIDUAL);
        UpdateParamValue(LCommand.Params,'FLAG_INDI_AMM', True);
        UpdateParamValue(LCommand.Params,'TELEFONO', LQuery.DataSet.FieldByName('TELEFONO').AsString);
        UpdateParamValue(LCommand.Params,'CELLULARE', LQuery.DataSet.FieldByName('CELLULARE').AsString);
        LCommand.Execute;
        Result := LCustomerId;
      end;
    finally
      LQuery.Close;
    end;
  finally
    FreeAndNil(LQuery);
    FreeAndNil(LCommand);
  end;


end;

//insert the collection entry for the subscription instalment
procedure InsertCollectionEntryFromPayments(const ARecord: TKRecord);
var
  LAutoReasonId: string;
  LAutoReasonDesc: string;
  LAutoAccountsQuery: TEFDBQuery;
  LReasonDataQuery: TEFDBQuery;
  LSubscriptionDataQuery: TEFDBQuery;
  LCommandInsertEntry: TEFDBCommand;
  LCommandInsertLine: TEFDBCommand;
  LEntryId : string;
  LLineId : string;
  LFinancialYearId : string;
  LNrMov : integer;
  LPayment: TKViewTableRecord;
  LEntryOk : boolean;
  LOpenItemId : string;
  LLineNumber : integer;
begin
  LEntryOk := False;
  LAutoAccountsQuery := TKConfig.Database.CreateDBQuery;
  LReasonDataQuery := TKConfig.Database.CreateDBQuery;
  LSubscriptionDataQuery := TKConfig.Database.CreateDBQuery;
  LCommandInsertEntry := TKConfig.Database.CreateDBCommand;
  LCommandInsertLine := TKConfig.Database.CreateDBCommand;
  try
    LSubscriptionDataQuery.CommandText := GetSQLSubscriptionData;
    LAutoReasonId := GetReason(PAYMENT_COLLECTION);
    LAutoReasonDesc := GetReasonDescription(PAYMENT_COLLECTION);
    if LAutoReasonId <> '' then
    begin
      LPayment := TKViewTableRecord(ARecord).Store.MasterRecord;
      LAutoAccountsQuery.CommandText := GetSQLAutomaticAccounts;
      LAutoAccountsQuery.Params.ParamByName('ID').AsString := PAYMENT_COLLECTION;
      LAutoAccountsQuery.Open;
      Try
        if not LAutoAccountsQuery.DataSet.IsEmpty then
        begin
          LCommandInsertEntry.CommandText := GetSQLInsertEntry;
          LCommandInsertLine.CommandText := GetSQLInsertLine;
          LSubscriptionDataQuery.CommandText := GetSQLSubscriptionData;
          LSubscriptionDataQuery.Params.ParamByName('ID').AsString := ARecord.FieldByName('SubscriptionInstalment_SubscriptionId').AsString;
          LSubscriptionDataQuery.Open;
          LReasonDataQuery.CommandText := GetSQLReasonData;
          LReasonDataQuery.Params.ParamByName('ID').AsString := LAutoReasonId;
          LReasonDataQuery.Open;
          LCommandInsertEntry.Connection.StartTransaction;
          Try
            //create the entry
            LEntryId := CreateCompactGuidStr;
            LFinancialYearId := GetFinancialYearFromDate(LPayment.FieldByName('PaymentDate').AsDateTime);
            LNrMov := NewEntryNumber(LFinancialYearId);
            UpdateParamValue(LCommandInsertEntry.Params,'ID', LEntryId);
            UpdateParamValue(LCommandInsertEntry.Params,'DX', LAutoReasonDesc);
            UpdateParamValue(LCommandInsertEntry.Params,'ESERCID', LFinancialYearId);
            UpdateParamValue(LCommandInsertEntry.Params,'NR_MOV', LNrMov);
            UpdateParamValue(LCommandInsertEntry.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
            UpdateParamValue(LCommandInsertEntry.Params,'DATA_REG', LPayment.FieldByName('PaymentDate').AsDateTime);
            UpdateParamValue(LCommandInsertEntry.Params,'TIPO_MOV', LReasonDataQuery.DataSet.FieldByName('TIPOREG').AsString);
            UpdateParamValue(LCommandInsertEntry.Params,'MOD_PAGAMENTOID', LPayment.FieldByName('PaymentMethodId').AsString);
            UpdateParamValue(LCommandInsertEntry.Params,'CAUSALEID', LAutoReasonId);
            UpdateParamValue(LCommandInsertEntry.Params,'IMPORTO', ARecord.FieldByName('PaidAmount').AsString);
            UpdateParamValue(LCommandInsertEntry.Params,'BANCAID', LPayment.FieldByName('DepositBankId').AsString);
            LCommandInsertEntry.Execute;
            LLineNumber := 0;
            while not LAutoAccountsQuery.DataSet.Eof do
            begin
              //for the debit line check against payment method and bank
              if LAutoAccountsQuery.DataSet.FieldByName('SEGNO').AsString = DEBIT_SIGN then
              begin
                if (LPayment.FieldByName('DepositBankId').AsString <> LAutoAccountsQuery.DataSet.FieldByName('BANCAID').AsString) or
                   (LPayment.FieldByName('PaymentMethodId').AsString <> LAutoAccountsQuery.DataSet.FieldByName('MODPAGAMENTOID').AsString) then
                begin
                  LAutoAccountsQuery.DataSet.Next;
                  Continue;
                end
                else
                  LEntryOk := True;
              end;
              Inc(LLineNumber);

              //Create the entry lines
              LLineId := CreateCompactGuidStr;
              UpdateParamValue(LCommandInsertLine.Params,'ID', LLineId);
              UpdateParamValue(LCommandInsertLine.Params,'DX', ARecord.FieldByName('SubscriptionInstalment').AsString);
              UpdateParamValue(LCommandInsertLine.Params,'MOVIMENTOID', LEntryId);
              UpdateParamValue(LCommandInsertLine.Params,'NR_RIGA', LLineNumber);
              UpdateParamValue(LCommandInsertLine.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
              UpdateParamValue(LCommandInsertLine.Params,'CONTOID', LAutoAccountsQuery.DataSet.FieldByName('CONTOID').AsString);
              UpdateParamValue(LCommandInsertLine.Params,'DATASCADENZA', LPayment.FieldByName('PaymentDate').AsDateTime);

              //only the credit line carries the item reference
              if LAutoAccountsQuery.DataSet.FieldByName('SEGNO').AsString = CREDIT_SIGN then
              begin
                LOpenItemId := LSubscriptionDataQuery.DataSet.FieldByName('CODFISC').AsString +' '+
                            DateToStr(ARecord.FieldByName('SubscriptionInstalment_DueDate').AsDateTime);

                UpdateParamValue(LCommandInsertLine.Params,'PARTITA', LOpenItemId);
              end
              else
                UpdateParamValue(LCommandInsertLine.Params,'PARTITA', '');

              UpdateParamValue(LCommandInsertLine.Params,'IMPORTO', ARecord.FieldByName('PaidAmount').AsString);
              UpdateParamValue(LCommandInsertLine.Params,'SEGNO', LAutoAccountsQuery.DataSet.FieldByName('SEGNO').AsString);
              UpdateParamValue(LCommandInsertLine.Params,'NOMINATIVOID', LSubscriptionDataQuery.DataSet.FieldByName('NOMINATIVOID').AsString);
              UpdateParamValue(LCommandInsertLine.Params,'BANCAID', LPayment.FieldByName('DepositBankId').AsString);
              LCommandInsertLine.Execute;
              LAutoAccountsQuery.DataSet.Next;
            end;
            if not LEntryOk then
              Raise EKValidationError.Create(_('Debit account for the automatic collection reason not found!'));
            LCommandInsertEntry.Connection.CommitTransaction;
          Except
            LCommandInsertEntry.Connection.RollbackTransaction;
            raise;
          End;

        end;
      Finally
        LAutoAccountsQuery.Close;
      End;
    end;
  finally
    FreeAndNil(LAutoAccountsQuery);
    FreeAndNil(LReasonDataQuery);
    FreeAndNil(LSubscriptionDataQuery);
    FreeAndNil(LCommandInsertEntry);
    FreeAndNil(LCommandInsertLine);
  end;

end;

//insert the subscription entry
procedure InsertSubscriptionEntry(const ARecord: TKRecord);
var
  LAutoReasonId: string;
  LAutoReasonDesc: string;
  LAutoAccountsQuery: TEFDBQuery;
  LReasonDataQuery: TEFDBQuery;
  LCommandInsertEntry: TEFDBCommand;
  LCommandInsertLine: TEFDBCommand;
  LEntryId : string;
  LLineId : string;
  LFinancialYearId : string;
  LNrMov : integer;
  LSubscription: TKViewTableRecord;
  LInstalments: TKViewTableStore;
  LInstalment: TKViewTableRecord;
  LLineNumber : integer;
  LOpenItemId : string;
  I: Integer;
begin
  LAutoAccountsQuery := TKConfig.Database.CreateDBQuery;
  LReasonDataQuery := TKConfig.Database.CreateDBQuery;
  LCommandInsertEntry := TKConfig.Database.CreateDBCommand;
  LCommandInsertLine := TKConfig.Database.CreateDBCommand;
  try
    LAutoReasonId := GetReason(SUBSCRIPTION);
    LAutoReasonDesc := GetReasonDescription(SUBSCRIPTION);
    if LAutoReasonId <> '' then
    begin
      LAutoAccountsQuery.CommandText := GetSQLAutomaticAccounts;
      LAutoAccountsQuery.Params.ParamByName('ID').AsString := SUBSCRIPTION;
      LAutoAccountsQuery.Open;
      Try
        if not LAutoAccountsQuery.DataSet.IsEmpty then
        begin
          LCommandInsertEntry.CommandText := GetSQLInsertEntry;
          LCommandInsertLine.CommandText := GetSQLInsertLine;
          LReasonDataQuery.CommandText := GetSQLReasonData;
          LReasonDataQuery.Params.ParamByName('ID').AsString := LAutoReasonId;
          LReasonDataQuery.Open;
          LCommandInsertEntry.Connection.StartTransaction;
          Try
            //create the entry
            LEntryId := CreateCompactGuidStr;
            LFinancialYearId := GetFinancialYearFromDate(ARecord.FieldByName('SubscriptionDate').AsDateTime);
            LNrMov := NewEntryNumber(LFinancialYearId);
            UpdateParamValue(LCommandInsertEntry.Params,'ID', LEntryId);
            UpdateParamValue(LCommandInsertEntry.Params,'DX', LAutoReasonDesc);
            UpdateParamValue(LCommandInsertEntry.Params,'ESERCID', LFinancialYearId);
            UpdateParamValue(LCommandInsertEntry.Params,'NR_MOV', LNrMov);
            UpdateParamValue(LCommandInsertEntry.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
            UpdateParamValue(LCommandInsertEntry.Params,'DATA_REG', ARecord.FieldByName('SubscriptionDate').AsDateTime);
            UpdateParamValue(LCommandInsertEntry.Params,'TIPO_MOV', LReasonDataQuery.DataSet.FieldByName('TIPOREG').AsString);
            UpdateParamValue(LCommandInsertEntry.Params,'CAUSALEID', LAutoReasonId);
            UpdateParamValue(LCommandInsertEntry.Params,'IMPORTO', ARecord.FieldByName('SubscriptionTotal').AsString);
            LCommandInsertEntry.Execute;

            LSubscription := (ARecord as TKViewTableRecord);
            LSubscription.LoadDetailStores;
            LInstalments := LSubscription.GetDetailStoreByModelName('SubscriptionInstalment');
            LLineNumber := 0;
            while not LAutoAccountsQuery.DataSet.Eof do
            begin
              //create one debit line per instalment
              if LAutoAccountsQuery.DataSet.FieldByName('SEGNO').AsString = DEBIT_SIGN then
              begin
                for I := 0 to LInstalments.RecordCount-1 do
                begin
                  LInstalment := LInstalments.Records[I];
                  LLineId := CreateCompactGuidStr;
                  Inc(LLineNumber);
                  UpdateParamValue(LCommandInsertLine.Params,'ID', LLineId);
                  UpdateParamValue(LCommandInsertLine.Params,'MOVIMENTOID', LEntryId);
                  UpdateParamValue(LCommandInsertLine.Params,'NR_RIGA', LLineNumber);
                  UpdateParamValue(LCommandInsertLine.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
                  UpdateParamValue(LCommandInsertLine.Params,'CONTOID', LAutoAccountsQuery.DataSet.FieldByName('CONTOID').AsString);
                  UpdateParamValue(LCommandInsertLine.Params,'SEGNO', LAutoAccountsQuery.DataSet.FieldByName('SEGNO').AsString);
                  UpdateParamValue(LCommandInsertLine.Params,'DX', LInstalment.FieldByName('Description').AsString);
                  UpdateParamValue(LCommandInsertLine.Params,'DATASCADENZA', LInstalment.FieldByName('DueDate').AsDateTime);
                  LOpenItemId := LSubscription.FieldByName('TaxCode').AsString +' '+
                             DateToStr( LInstalment.FieldByName('DueDate').AsDateTime);
                  UpdateParamValue(LCommandInsertLine.Params,'PARTITA', LOpenItemId);
                  UpdateParamValue(LCommandInsertLine.Params,'IMPORTO', LInstalment.FieldByName('Amount').AsString);
                  UpdateParamValue(LCommandInsertLine.Params,'NOMINATIVOID', LInstalment.FieldByName('Subscription_PersonId').AsString);
                  LCommandInsertLine.Execute;
                end;
              end
              else //create the credit line with the subscription total
              begin
                LLineId := CreateCompactGuidStr;
                Inc(LLineNumber);
                UpdateParamValue(LCommandInsertLine.Params,'ID', LLineId);
                UpdateParamValue(LCommandInsertLine.Params,'MOVIMENTOID', LEntryId);
                UpdateParamValue(LCommandInsertLine.Params,'NR_RIGA', LLineNumber);
                UpdateParamValue(LCommandInsertLine.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
                UpdateParamValue(LCommandInsertLine.Params,'CONTOID', LAutoAccountsQuery.DataSet.FieldByName('CONTOID').AsString);
                UpdateParamValue(LCommandInsertLine.Params,'SEGNO', LAutoAccountsQuery.DataSet.FieldByName('SEGNO').AsString);
                UpdateParamValue(LCommandInsertLine.Params,'DX', ARecord.FieldByName('Description').AsString);
                UpdateParamValue(LCommandInsertLine.Params,'DATASCADENZA', ARecord.FieldByName('SubscriptionDate').AsDateTime);
                UpdateParamValue(LCommandInsertLine.Params,'PARTITA', '');
                UpdateParamValue(LCommandInsertLine.Params,'IMPORTO', ARecord.FieldByName('SubscriptionTotal').AsString);
                LCommandInsertLine.Execute;
              end;

              LAutoAccountsQuery.DataSet.Next;
            end;
            LCommandInsertEntry.Connection.CommitTransaction;
          Except
            LCommandInsertEntry.Connection.RollbackTransaction;
            raise;
          End;

        end;
      Finally
        LAutoAccountsQuery.Close;
      End;
    end;
  finally
    FreeAndNil(LAutoAccountsQuery);
    FreeAndNil(LReasonDataQuery);
    FreeAndNil(LCommandInsertEntry);
    FreeAndNil(LCommandInsertLine);
  end;
end;


