procedure CloseAndReopenBalanceSheet(const ServerStore: TKViewTableStore);
var
  i : integer;
  LRecordStore : TKViewTableRecord;

  LOpeningAutoReasonId: string;
  LOpeningAutoReasonDesc: string;
  LOpeningReasonDataQuery: TEFDBQuery;
  LOpeningAutoAccountsQuery: TEFDBQuery;

  LClosingAutoReasonId: string;
  LClosingAutoReasonDesc: string;
  LClosingReasonDataQuery: TEFDBQuery;
  LClosingAutoAccountsQuery: TEFDBQuery;
  LCounterpartBalanceQuery: TEFDBQuery;

  LCommandInsertEntry: TEFDBCommand;
  LCommandInsertLine: TEFDBCommand;

  LClosingYearId, LOpeningYearId : string;
  LFinancialYearEnd : TDateTime;
  LFinancialYearStart : TDateTime;

  LProfitOrLoss : Currency;

  procedure GetYearEndData;
  var
    LNextYearQuery: TEFDBQuery;
    LFinancialYearId: TEFDBQuery;
  begin

    LClosingYearId := LRecordStore.FieldByName('FinancialYearId').AsString;

    //read the data of the selected financial year
    LFinancialYearId := TKConfig.Database.CreateDBQuery;
    try
      LFinancialYearId.CommandText := 'SELECT ID, DATAFINE, STATO FROM ESERCIZICONTABILI WHERE ID = :ID';
      LFinancialYearId.Params.ParamByName('ID').AsString := LClosingYearId;
      LFinancialYearId.Open;
      if (not LFinancialYearId.DataSet.IsEmpty) then
      begin
        if LFinancialYearId.DataSet.FieldByName('STATO').AsString = YEAR_CLOSED then
          raise EKValidationError.CreateWithAdditionalInfo(_('The financial year is already closed.'), _('Close/open financial year'));

        LFinancialYearEnd := LFinancialYearId.DataSet.FieldByName('DATAFINE').AsDateTime;
      end;
    finally
      LFinancialYearId.Free;
    end;

    LFinancialYearEnd := EFVarToDateTime(TKConfig.Database.GetSingletonValue('SELECT DATAFINE FROM ESERCIZICONTABILI WHERE ID = '+QuotedStr(LRecordStore.FieldByName('FinancialYearId').AsString))) ;

    LNextYearQuery := TKConfig.Database.CreateDBQuery;
    try
      LNextYearQuery.CommandText := 'SELECT ID, DATAINIZIO, STATO FROM ESERCIZICONTABILI WHERE DATAINIZIO = :DATAINI AND STATO = '+QuotedStr(YEAR_OPEN);
      LNextYearQuery.Params.ParamByName('DATAINI').AsDateTime := LFinancialYearEnd+1;
      LNextYearQuery.Open;
      if (not LNextYearQuery.DataSet.IsEmpty) then
      begin
        LOpeningYearId := LNextYearQuery.DataSet.FieldByName('ID').AsString;
        LFinancialYearStart := LNextYearQuery.DataSet.FieldByName('DATAINIZIO').AsDateTime;
      end
      else
        raise EKValidationError.CreateWithAdditionalInfo(_('The next open financial year was not found.'), _('Close/open financial year'));
    finally
      LNextYearQuery.Free;
    end;
  end;

begin
  LOpeningReasonDataQuery := TKConfig.Database.CreateDBQuery;
  LOpeningAutoAccountsQuery := TKConfig.Database.CreateDBQuery;

  LClosingReasonDataQuery := TKConfig.Database.CreateDBQuery;
  LClosingAutoAccountsQuery := TKConfig.Database.CreateDBQuery;

  LCounterpartBalanceQuery := TKConfig.Database.CreateDBQuery;

  LCommandInsertEntry := TKConfig.Database.CreateDBCommand;
  LCommandInsertLine := TKConfig.Database.CreateDBCommand;
  LClosingYearId := '';
  try
    //data of the opening reason
    LOpeningAutoReasonId := GetReason(BALANCE_SHEET_OPENING);
    LOpeningAutoReasonDesc := GetReasonDescription(BALANCE_SHEET_OPENING);

    //data of the closing reason
    LClosingAutoReasonId := GetReason(BALANCE_SHEET_CLOSING);
    LClosingAutoReasonDesc := GetReasonDescription(BALANCE_SHEET_CLOSING);

    if (LOpeningAutoReasonId <> '') and (LClosingAutoReasonId <> '') then
    begin
      //automatic accounts of the opening reason
      LOpeningAutoAccountsQuery.CommandText := GetSQLAutomaticAccounts;
      LOpeningAutoAccountsQuery.Params.ParamByName('ID').AsString := BALANCE_SHEET_OPENING;
      LOpeningAutoAccountsQuery.Open;

      //automatic accounts of the closing reason
      LClosingAutoAccountsQuery.CommandText := GetSQLAutomaticAccounts;
      LClosingAutoAccountsQuery.Params.ParamByName('ID').AsString := BALANCE_SHEET_CLOSING;
      LClosingAutoAccountsQuery.Open;


      LCounterpartBalanceQuery.CommandText := GetSQLCounterpartBalance;

      Try
        if (not LOpeningAutoAccountsQuery.DataSet.IsEmpty) and
           (not LClosingAutoAccountsQuery.DataSet.IsEmpty) then
        begin
          LCommandInsertEntry.CommandText := GetSQLInsertEntry;
          LCommandInsertLine.CommandText := GetSQLInsertLine;

          LOpeningReasonDataQuery.CommandText := GetSQLReasonData;
          LOpeningReasonDataQuery.Params.ParamByName('ID').AsString := LOpeningAutoReasonId;
          LOpeningReasonDataQuery.Open;

          LClosingReasonDataQuery.CommandText := GetSQLReasonData;
          LClosingReasonDataQuery.Params.ParamByName('ID').AsString := LClosingAutoReasonId;
          LClosingReasonDataQuery.Open;

          LCommandInsertEntry.Connection.StartTransaction;
          Try
            //create the entries
            LProfitOrLoss := 0;

            for i := 0 to ServerStore.RecordCount-1 do
            begin
              LRecordStore := ServerStore.Records[i];

              //read the financial year data
              if (LClosingYearId = '') then
                GetYearEndData;

              if (LRecordStore.FieldByName('Level').AsString = 'S') and
                 (LRecordStore.FieldByName('Balance').AsCurrency <> 0) then
              begin
                //Compute the profit and loss of the year
                if (LRecordStore.FieldByName('Section').AsString = 'R') or
                   (LRecordStore.FieldByName('Section').AsString = 'C') then
                begin
                  if LRecordStore.FieldByName('Sign').AsString = DEBIT_SIGN then
                    LProfitOrLoss := LProfitOrLoss+LRecordStore.FieldByName('Balance').AsCurrency
                  else
                    LProfitOrLoss := LProfitOrLoss-LRecordStore.FieldByName('Balance').AsCurrency;
                end;

                if LCounterpartBalanceQuery.DataSet.Active then
                  LCounterpartBalanceQuery.Close;

                //read the counterpart detail of the account
                LCounterpartBalanceQuery.Params.ParamByName('ID').AsString := LRecordStore.FieldByName('AccountId').AsString;
                LCounterpartBalanceQuery.Params.ParamByName('ESERCID').AsString := LClosingYearId;
                LCounterpartBalanceQuery.Open;

                //TODO: one closing and one opening entry is created per sub-account
                //they could be grouped by parent code, one entry per account
                //closing entry of the financial year
                InsertClosingEntry(LCommandInsertEntry, LCommandInsertLine, LClosingYearId,
                               LClosingAutoReasonId, LClosingAutoReasonDesc, LFinancialYearEnd,
                               LClosingReasonDataQuery, LClosingAutoAccountsQuery,
                               LCounterpartBalanceQuery,
                               LRecordStore.FieldByName('AccountId').AsString,
                               LRecordStore.FieldByName('Description').AsString,
                               LRecordStore.FieldByName('Sign').AsString,
                               LRecordStore.FieldByName('Section').AsString,
                               LRecordStore.FieldByName('Balance').AsCurrency);

                //opening entry of the next year for the balance sheet
                if (LRecordStore.FieldByName('Section').AsString = 'A') or
                   (LRecordStore.FieldByName('Section').AsString = 'P')  then
                  InsertOpeningEntry(LCommandInsertEntry, LCommandInsertLine, LOpeningYearId,
                                 LOpeningAutoReasonId, LOpeningAutoReasonDesc, LFinancialYearStart,
                                 LOpeningReasonDataQuery, LOpeningAutoAccountsQuery,
                                 LCounterpartBalanceQuery,
                                 LRecordStore.FieldByName('AccountId').AsString,
                                 LRecordStore.FieldByName('Description').AsString,
                                 LRecordStore.FieldByName('Sign').AsString,
                                 LRecordStore.FieldByName('Balance').AsCurrency);
              end;
            end;

            if LProfitOrLoss <> 0 then
            begin
              //result of the year, closing side
              InsertProfitOrLossEntry(LCommandInsertEntry, LCommandInsertLine, LClosingYearId,
                                 LClosingAutoReasonId, LClosingAutoReasonDesc, LFinancialYearEnd,
                                 LClosingReasonDataQuery, LClosingAutoAccountsQuery,
                                 LProfitOrLoss, False);

              //result of the year, opening side
              InsertProfitOrLossEntry(LCommandInsertEntry, LCommandInsertLine, LOpeningYearId,
                                 LOpeningAutoReasonId, LOpeningAutoReasonDesc, LFinancialYearStart,
                                 LOpeningReasonDataQuery, LOpeningAutoAccountsQuery,
                                 LProfitOrLoss, True);

            end;


            CloseFinancialYear(LClosingYearId);
            LCommandInsertEntry.Connection.CommitTransaction;
          Except
            LCommandInsertEntry.Connection.RollbackTransaction;
            raise;

          End;

        end;
      Finally
        LOpeningAutoAccountsQuery.Close;
        LClosingAutoAccountsQuery.Close;
        if LCounterpartBalanceQuery.DataSet.Active then
          LCounterpartBalanceQuery.Close;
      End;
    end;


  finally
    FreeAndNil(LOpeningAutoAccountsQuery);
    FreeAndNil(LOpeningReasonDataQuery);
    FreeAndNil(LClosingAutoAccountsQuery);
    FreeAndNil(LClosingReasonDataQuery);
    FreeAndNil(LCounterpartBalanceQuery);
    FreeAndNil(LCommandInsertEntry);
    FreeAndNil(LCommandInsertLine);
  end;

end;


procedure InsertProfitOrLossEntry(const ACommandInsertEntry, ACommandInsertLine: TEFDBCommand;
  AFinancialYearId, AAutoReasonId, AAutoReasonDesc : string; ADate : TDateTime;
  AReasonDataQuery, AAutoAccountsQuery: TEFDBQuery;
  LProfitOrLoss : Currency; ANewFinancialYear : boolean);
var
  LDebitAccount, LCreditAccount : string;
  LDebitDesc, LCreditDesc : string;
  LEntryId : string;
  LLineId : string;
  LNrMov : integer;
  LLineNumber : integer;

  LAutomaticReasonId : string;
  LAutoReasonId, LAutoReasonDesc : string;
  LAutoAccountsQuery: TEFDBQuery;
  LReasonDataQuery: TEFDBQuery;


  LAccountId, LDescription, LSign, LSection : string;

begin
  //insert the entry that posts the result of the year
  if ANewFinancialYear then
  begin
    if LProfitOrLoss > 0 then
      LAutomaticReasonId := PREV_YEAR_PROFIT
    else
      LAutomaticReasonId := PREV_YEAR_LOSS;
  end
  else
  begin
    if LProfitOrLoss > 0 then
      LAutomaticReasonId := YEAR_PROFIT
    else
      LAutomaticReasonId := YEAR_LOSS;
  end;

  LReasonDataQuery := TKConfig.Database.CreateDBQuery;
  LAutoAccountsQuery := TKConfig.Database.CreateDBQuery;
  try

    LAutoReasonId := GetReason(LAutomaticReasonId);
    LAutoReasonDesc := GetReasonDescription(LAutomaticReasonId);
    if LAutoReasonId <> '' then
    begin
      LAutoAccountsQuery.CommandText := GetSQLAutomaticAccounts;
      LAutoAccountsQuery.Params.ParamByName('ID').AsString := LAutomaticReasonId;
      LAutoAccountsQuery.Open;
      Try

        LReasonDataQuery.CommandText := GetSQLReasonData;
        LReasonDataQuery.Params.ParamByName('ID').AsString := LAutoReasonId;
        LReasonDataQuery.Open;

        LEntryId := CreateCompactGuidStr;
        LNrMov := NewEntryNumber(AFinancialYearId);
        UpdateParamValue(ACommandInsertEntry.Params,'ID', LEntryId);
        UpdateParamValue(ACommandInsertEntry.Params,'DX', LAutoReasonDesc);
        UpdateParamValue(ACommandInsertEntry.Params,'ESERCID', AFinancialYearId);
        UpdateParamValue(ACommandInsertEntry.Params,'NR_MOV', LNrMov);
        UpdateParamValue(ACommandInsertEntry.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
        UpdateParamValue(ACommandInsertEntry.Params,'DATA_REG', ADate);
        UpdateParamValue(ACommandInsertEntry.Params,'TIPO_MOV', LReasonDataQuery.DataSet.FieldByName('TIPOREG').AsString);
        UpdateParamValue(ACommandInsertEntry.Params,'CAUSALEID', LAutoReasonId);
        UpdateParamValue(ACommandInsertEntry.Params,'IMPORTO', Abs(LProfitOrLoss));
        ACommandInsertEntry.Execute;

        if LAutoAccountsQuery.DataSet.Locate('SEGNO', CREDIT_SIGN, []) then
        begin
          LCreditAccount := LAutoAccountsQuery.DataSet.FieldByName('CONTOID').AsString;
          LCreditDesc  := LAutoAccountsQuery.DataSet.FieldByName('DESC_CONTO').AsString;

          if (ANewFinancialYear and (LProfitOrLoss > 0)) or
             ((not ANewFinancialYear) and (LProfitOrLoss < 0))  then
          begin
            LAccountId := LAutoAccountsQuery.DataSet.FieldByName('CONTOID').AsString;
            LDescription := LAutoAccountsQuery.DataSet.FieldByName('DESC_CONTO').AsString;
            //ON A NEW FINANCIAL YEAR THE SIGN TO PASS IS DEBIT
            if ANewFinancialYear then
              LSign := DEBIT_SIGN
            else
              LSign := CREDIT_SIGN;
            LSection := LAutoAccountsQuery.DataSet.FieldByName('SEZIONE').AsString;

          end;

        end
        else
          raise EKValidationError.CreateWithAdditionalInfo(_('Credit account not found.'), _('Posting of profit/loss for the year'));


        if LAutoAccountsQuery.DataSet.Locate('SEGNO', DEBIT_SIGN, []) then
        begin
          LDebitAccount := LAutoAccountsQuery.DataSet.FieldByName('CONTOID').AsString;
          LDebitDesc :=  LAutoAccountsQuery.DataSet.FieldByName('DESC_CONTO').AsString;

          if (ANewFinancialYear and (LProfitOrLoss < 0)) or
             ((not ANewFinancialYear) and (LProfitOrLoss > 0))  then
          begin
            LAccountId := LAutoAccountsQuery.DataSet.FieldByName('CONTOID').AsString;
            LDescription := LAutoAccountsQuery.DataSet.FieldByName('DESC_CONTO').AsString;
            //ON A NEW FINANCIAL YEAR THE SIGN TO PASS IS CREDIT
            if ANewFinancialYear then
              LSign := CREDIT_SIGN
            else
              LSign := DEBIT_SIGN;
            LSection := LAutoAccountsQuery.DataSet.FieldByName('SEZIONE').AsString;

          end;
        end
        else
          raise EKValidationError.CreateWithAdditionalInfo(_('Debit account not found.'), _('Posting of profit/loss for the year'));

        LLineNumber := 0;
        //insert debit line
        LLineId := CreateCompactGuidStr;
        Inc(LLineNumber);
        UpdateParamValue(ACommandInsertLine.Params,'ID', LLineId);
        UpdateParamValue(ACommandInsertLine.Params,'MOVIMENTOID', LEntryId);
        UpdateParamValue(ACommandInsertLine.Params,'NR_RIGA', LLineNumber);
        UpdateParamValue(ACommandInsertLine.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
        UpdateParamValue(ACommandInsertLine.Params,'CONTOID', LDebitAccount);
        UpdateParamValue(ACommandInsertLine.Params,'SEGNO', DEBIT_SIGN);
        UpdateParamValue(ACommandInsertLine.Params,'DX', LDebitDesc);
        UpdateParamValue(ACommandInsertLine.Params,'DATASCADENZA', ADate);
        UpdateParamValue(ACommandInsertLine.Params,'PARTITA', '');
        UpdateParamValue(ACommandInsertLine.Params,'IMPORTO', Abs(LProfitOrLoss));
        UpdateParamValue(ACommandInsertLine.Params,'NOMINATIVOID', '');
        UpdateParamValue(ACommandInsertLine.Params,'FORNITOREID', '');
        UpdateParamValue(ACommandInsertLine.Params,'CLIENTEID', '');
        ACommandInsertLine.Execute;

        //insert credit line
        LLineId := CreateCompactGuidStr;
        Inc(LLineNumber);
        UpdateParamValue(ACommandInsertLine.Params,'ID', LLineId);
        UpdateParamValue(ACommandInsertLine.Params,'MOVIMENTOID', LEntryId);
        UpdateParamValue(ACommandInsertLine.Params,'NR_RIGA', LLineNumber);
        UpdateParamValue(ACommandInsertLine.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
        UpdateParamValue(ACommandInsertLine.Params,'CONTOID', LCreditAccount);
        UpdateParamValue(ACommandInsertLine.Params,'SEGNO', CREDIT_SIGN);
        UpdateParamValue(ACommandInsertLine.Params,'DX', LCreditDesc);
        UpdateParamValue(ACommandInsertLine.Params,'DATASCADENZA', ADate);
        UpdateParamValue(ACommandInsertLine.Params,'PARTITA', '');
        UpdateParamValue(ACommandInsertLine.Params,'IMPORTO', Abs(LProfitOrLoss));
        UpdateParamValue(ACommandInsertLine.Params,'NOMINATIVOID', '');
        UpdateParamValue(ACommandInsertLine.Params,'FORNITOREID', '');
        UpdateParamValue(ACommandInsertLine.Params,'CLIENTEID', '');
        ACommandInsertLine.Execute;

        if ANewFinancialYear then
        begin
          InsertOpeningEntry(ACommandInsertEntry, ACommandInsertLine, AFinancialYearId,
                         AAutoReasonId, AAutoReasonDesc, ADate,
                         AReasonDataQuery, AAutoAccountsQuery,
                         nil,
                         LAccountId,
                         LDescription,
                         LSign,
                         Abs(LProfitOrLoss));
        end
        else
        begin
          //closing entry of the financial year
          InsertClosingEntry(ACommandInsertEntry, ACommandInsertLine, AFinancialYearId,
                         AAutoReasonId, AAutoReasonDesc, ADate,
                         AReasonDataQuery, AAutoAccountsQuery,
                         nil,
                         LAccountId,
                         LDescription,
                         LSign,
                         LSection,
                         Abs(LProfitOrLoss));
        end;


      Finally
        LAutoAccountsQuery.Close;
      End;
    end;
  finally
    LReasonDataQuery.Free;
    LAutoAccountsQuery.Free;
  end;
end;

procedure InsertClosingEntry(const ACommandInsertEntry, ACommandInsertLine: TEFDBCommand;
  AClosingYearId, AClosingAutoReasonId, AClosingAutoReasonDesc : string; AFinancialYearEnd : TDateTime;
  AClosingReasonDataQuery, AClosingAutoAccountsQuery, ACounterpartBalanceQuery: TEFDBQuery;
  AAccountId, ADescription, ASign, ASection : string; ABalance : Currency);
var
  LEntryId : string;
  LLineId : string;
  LNrMov : integer;
  LLineNumber : integer;
  LTotalDebit : Currency;
  LTotalCredit : Currency;

  procedure InsertBalanceLines(AAccountBalance : Currency; ABalanceSign: string;
                             APersonId : string = ''; ASupplierId : string = ''; ACustomerId : string = '');
  var
    LSign : string;
  begin

    if ABalanceSign = DEBIT_SIGN then
      LSign := CREDIT_SIGN
    else
      LSign := DEBIT_SIGN;


    if LSign = DEBIT_SIGN then
      LTotalDebit := LTotalDebit + AAccountBalance
    else
      LTotalCredit := LTotalCredit + AAccountBalance;

    //insert debit line
    LLineId := CreateCompactGuidStr;
    Inc(LLineNumber);
    UpdateParamValue(ACommandInsertLine.Params,'ID', LLineId);
    UpdateParamValue(ACommandInsertLine.Params,'MOVIMENTOID', LEntryId);
    UpdateParamValue(ACommandInsertLine.Params,'NR_RIGA', LLineNumber);
    UpdateParamValue(ACommandInsertLine.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
    UpdateParamValue(ACommandInsertLine.Params,'CONTOID', AAccountId);
    UpdateParamValue(ACommandInsertLine.Params,'SEGNO', LSign);
    UpdateParamValue(ACommandInsertLine.Params,'DX', ADescription);
    UpdateParamValue(ACommandInsertLine.Params,'DATASCADENZA', AFinancialYearEnd);
    UpdateParamValue(ACommandInsertLine.Params,'PARTITA', '');
    UpdateParamValue(ACommandInsertLine.Params,'IMPORTO', AAccountBalance);
    UpdateParamValue(ACommandInsertLine.Params,'NOMINATIVOID', APersonId);
    UpdateParamValue(ACommandInsertLine.Params,'FORNITOREID', ASupplierId);
    UpdateParamValue(ACommandInsertLine.Params,'CLIENTEID', ACustomerId);
    ACommandInsertLine.Execute;

  end;

  procedure InsertBalanceSheetLines;
  var
    LAccount : string;
    LDesc : string;
    LSection : string;
  begin

    if (ASection = 'A') or
       (ASection = 'P') then
      LSection := 'P'
    else
      LSection := 'C';

    //BALANCE SHEET DEBIT LINE
    if LTotalCredit > 0 then
    begin

      if AClosingAutoAccountsQuery.DataSet.Locate('SEGNO;SEZIONE', VarArrayOf([DEBIT_SIGN,LSection]), []) then
      begin
        LAccount := AClosingAutoAccountsQuery.DataSet.FieldByName('CONTOID').AsString;
        LDesc :=  AClosingAutoAccountsQuery.DataSet.FieldByName('DESC_CONTO').AsString;
      end;

      LLineId := CreateCompactGuidStr;
      Inc(LLineNumber);
      UpdateParamValue(ACommandInsertLine.Params,'ID', LLineId);
      UpdateParamValue(ACommandInsertLine.Params,'MOVIMENTOID', LEntryId);
      UpdateParamValue(ACommandInsertLine.Params,'NR_RIGA', LLineNumber);
      UpdateParamValue(ACommandInsertLine.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
      UpdateParamValue(ACommandInsertLine.Params,'CONTOID', LAccount);
      UpdateParamValue(ACommandInsertLine.Params,'SEGNO', DEBIT_SIGN);
      UpdateParamValue(ACommandInsertLine.Params,'DX', LDesc);
      UpdateParamValue(ACommandInsertLine.Params,'DATASCADENZA', AFinancialYearEnd);
      UpdateParamValue(ACommandInsertLine.Params,'PARTITA', '');
      UpdateParamValue(ACommandInsertLine.Params,'IMPORTO', Abs(LTotalCredit));
      UpdateParamValue(ACommandInsertLine.Params,'NOMINATIVOID', '');
      UpdateParamValue(ACommandInsertLine.Params,'FORNITOREID', '');
      UpdateParamValue(ACommandInsertLine.Params,'CLIENTEID', '');
      ACommandInsertLine.Execute;
    end;

    //BALANCE SHEET CREDIT LINE
    if LTotalDebit > 0 then
    begin
      if AClosingAutoAccountsQuery.DataSet.Locate('SEGNO;SEZIONE', VarArrayOf([CREDIT_SIGN,LSection]), []) then
      begin
        LAccount := AClosingAutoAccountsQuery.DataSet.FieldByName('CONTOID').AsString;
        LDesc :=  AClosingAutoAccountsQuery.DataSet.FieldByName('DESC_CONTO').AsString;
      end;
      //insert credit line
      LLineId := CreateCompactGuidStr;
      Inc(LLineNumber);
      UpdateParamValue(ACommandInsertLine.Params,'ID', LLineId);
      UpdateParamValue(ACommandInsertLine.Params,'MOVIMENTOID', LEntryId);
      UpdateParamValue(ACommandInsertLine.Params,'NR_RIGA', LLineNumber);
      UpdateParamValue(ACommandInsertLine.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
      UpdateParamValue(ACommandInsertLine.Params,'CONTOID', LAccount);
      UpdateParamValue(ACommandInsertLine.Params,'SEGNO', CREDIT_SIGN);
      UpdateParamValue(ACommandInsertLine.Params,'DX', LDesc);
      UpdateParamValue(ACommandInsertLine.Params,'DATASCADENZA', AFinancialYearEnd);
      UpdateParamValue(ACommandInsertLine.Params,'PARTITA', '');
      UpdateParamValue(ACommandInsertLine.Params,'IMPORTO', Abs(LTotalDebit));
      UpdateParamValue(ACommandInsertLine.Params,'NOMINATIVOID', '');
      UpdateParamValue(ACommandInsertLine.Params,'FORNITOREID', '');
      UpdateParamValue(ACommandInsertLine.Params,'CLIENTEID', '');
      ACommandInsertLine.Execute;
    end;
  end;

begin
  LLineNumber := 0;
  LTotalCredit := 0;
  LTotalDebit := 0;

  //insert the closing entry
  LEntryId := CreateCompactGuidStr;
  LNrMov := NewEntryNumber(AClosingYearId);
  UpdateParamValue(ACommandInsertEntry.Params,'ID', LEntryId);
  UpdateParamValue(ACommandInsertEntry.Params,'DX', AClosingAutoReasonDesc);
  UpdateParamValue(ACommandInsertEntry.Params,'ESERCID', AClosingYearId);
  UpdateParamValue(ACommandInsertEntry.Params,'NR_MOV', LNrMov);
  UpdateParamValue(ACommandInsertEntry.Params,'UTENTE_INSERIMENTOID', TKConfig.Instance.Authenticator.UserName);
  UpdateParamValue(ACommandInsertEntry.Params,'DATA_REG', AFinancialYearEnd);
  UpdateParamValue(ACommandInsertEntry.Params,'TIPO_MOV', AClosingReasonDataQuery.DataSet.FieldByName('TIPOREG').AsString);
  UpdateParamValue(ACommandInsertEntry.Params,'CAUSALEID', AClosingAutoReasonId);
  UpdateParamValue(ACommandInsertEntry.Params,'IMPORTO', Abs(ABalance));
  ACommandInsertEntry.Execute;

  //create the lines with the counterpart detail
  if Assigned(ACounterpartBalanceQuery) and  (not ACounterpartBalanceQuery.DataSet.IsEmpty) then
  begin
    with ACounterpartBalanceQuery.DataSet do
    begin
      First;
      while not Eof do
      begin
        InsertBalanceLines(Abs(FieldByName('SALDO').AsCurrency),
                         FieldByName('SEGNO_SALDO').AsString,
                         FieldByName('NOMINATIVOID').AsString,
                         FieldByName('FORNITOREID').AsString,
                         FieldByName('CLIENTEID').AsString );
        Next;
      end;
    end;
  end
  else
  begin
    InsertBalanceLines(ABalance, ASign);
  end;

  InsertBalanceSheetLines;

  //update the entry amount
  TKConfig.Database.ExecuteImmediate('UPDATE MOVIMENTI_CONTABILI SET IMPORTO = '+StringReplace(CurrToStr(LTotalCredit+LTotalDebit), ',', '.',[])+' WHERE ID = '+QuotedStr(LEntryId) );

end;

